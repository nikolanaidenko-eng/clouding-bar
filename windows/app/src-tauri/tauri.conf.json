{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clouding Bar",
  "version": "1.0.0",
  "identifier": "dev.cloudingbar.windows",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "widget",
        "title": "Clouding Bar",
        "url": "index.html",
        "width": 260,
        "height": 56,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/cloudingbar-hook"],
    "shortDescription": "Claude Code at a glance",
    "longDescription": "Clouding Bar shows Claude Code's limits and context in a floating pill and lets you answer its questions and permission requests.",
    "copyright": "© 2026 Nikola Naidenko · PolyForm Shield 1.0.0",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
